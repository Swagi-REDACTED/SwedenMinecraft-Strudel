// ============================================================
// C418 — SWEDEN
// Minecraft Volume Alpha
//
// SOURCE:
// Online Sequencer #1140127
// https://onlinesequencer.net/1140127
//
// DIRECT CONVERSION OF THE EVENT DATA
//
// Online Sequencer:
//   8 time units = 1 bar
//   4 time units = half-bar
//   2 time units = quarter-bar
//   1 time unit  = eighth-bar
//
// Strudel:
//   [a,b,c] = simultaneous
//   @n       = event occupies n time units
//   ~@n      = rest occupying n time units
//   cat()    = each entry is one complete bar
//
// 23 BARS
// ============================================================

setcpm(48 / 4)


// ============================================================
// MAIN PIANO
//
// These are the LONG events from the Online Sequencer data.
// Every pitch and onset comes directly from the supplied data.
//
// There is NO invented bass loop here.
// There is NO repeated "E F# B A G D" pattern being generated.
// ============================================================

const sweden = cat(

  // ==========================================================
  // BAR 01 — time 0 → 8
  // ==========================================================

  "[e3,e4,g4]@4 f#3@4",

  // ==========================================================
  // BAR 02 — time 8 → 16
  // ==========================================================

  "[g3,a4,d5]@4 b3@4",

  // ==========================================================
  // BAR 03 — time 16 → 24
  // ==========================================================

  "[a3,a4,f#4]@4 g3@4",

  // ==========================================================
  // BAR 04 — time 24 → 32
  // ==========================================================

  "[d3,a4,c#5]@4 ~@4",

  // ==========================================================
  // BAR 05 — time 32 → 40
  // ==========================================================

  "[e3,e4,g4]@4 f#3@4",

  // ==========================================================
  // BAR 06 — time 40 → 48
  // ==========================================================

  "[g3,a4,d5]@4 b3@4",

  // ==========================================================
  // BAR 07 — time 48 → 56
  // ==========================================================

  "[a3,a4,f#4]@4 g3@4",

  // ==========================================================
  // BAR 08 — time 56 → 64
  // ==========================================================

  "[d3,a4,c#5]@4 ~@4",

  // ==========================================================
  // BAR 09 — time 64 → 72
  // ==========================================================

  "[e3,e4,g4,b4]@4 f#3@4",

  // ==========================================================
  // BAR 10 — time 72 → 80
  // ==========================================================

  "[g3,a4,d5,f#5]@4 b3@4",

  // ==========================================================
  // BAR 11 — time 80 → 88
  // ==========================================================

  "[a3,f#4,a4,c#5]@4 g3@4",

  // ==========================================================
  // BAR 12 — time 88 → 96
  // ==========================================================

  "[d3,a4,c#5,e5]@4 ~@4",

  // ==========================================================
  // BAR 13 — time 96 → 104
  // ==========================================================

  "[e3,e4,g4,b4]@4 f#3@4",

  // ==========================================================
  // BAR 14 — time 104 → 112
  // ==========================================================

  "[g3,a4,d5,f#5]@4 b3@4",

  // ==========================================================
  // BAR 15 — time 112 → 120
  // ==========================================================

  "[a3,f#4,a4,c#5]@4 g3@4",

  // ==========================================================
  // BAR 16 — time 120 → 128
  // ==========================================================

  "[d3,a4,c#5,e5]@4 ~@4",

  // ==========================================================
  // BAR 17 — time 128 → 136
  // ==========================================================

  "[e3,e4,g4,b4]@4 f#3@4",

  // ==========================================================
  // BAR 18 — time 136 → 144
  // ==========================================================

  "[g3,a4,d5,f#5]@4 b3@4",

  // ==========================================================
  // BAR 19 — time 144 → 152
  // ==========================================================

  "[a3,f#4,a4,c#5]@4 g3@4",

  // ==========================================================
  // BAR 20 — time 152 → 160
  // ==========================================================

  "[d3,a4,c#5,e5]@4 ~@4",

  // ==========================================================
  // BAR 21 — time 160 → 168
  // ==========================================================

  "e3@4 f#3@4",

  // ==========================================================
  // BAR 22 — time 168 → 176
  // ==========================================================

  "[g3,a4,d5,f#5]@4 b3@4",

  // ==========================================================
  // BAR 23 — time 176 → 184
  // ==========================================================

  "[a3,f#4,a4,c#5]@4 g3@4"
)


// ============================================================
// SHORT / ORNAMENT EVENTS
//
// These are kept separate because the source contains events
// whose durations are 1 or 2 while other notes at the same
// timestamp last 4.
//
// This preserves their actual timing instead of incorrectly
// forcing everything into the same chord duration.
// ============================================================

const ornaments = cat(

  // BAR 01
  "~@8",

  // BAR 02
  "~@8",

  // BAR 03
  "~@8",

  // BAR 04
  "~@8",

  // BAR 05
  "~@8",

  // BAR 06
  "~@8",

  // BAR 07
  "~@8",

  // BAR 08
  "~@8",

  // BAR 09
  "~@8",

  // BAR 10
  "~@8",

  // BAR 11
  "~@8",

  // BAR 12
  "~@8",

  // BAR 13
  "~@8",

  // BAR 14
  "~@8",

  // BAR 15
  "~@8",

  // BAR 16
  "~@8",

  // BAR 17
  // t=132 A5 for 2
  // t=134 B5 for 2
  "~@4 a5@2 b5@2",

  // BAR 18
  // t=142 D5 for 1
  // t=143 E5 for 1
  "~@6 d5 e5",

  // BAR 19
  // t=150 F#5 for 1
  // t=151 A5 for 1
  "~@6 f#5 a5",

  // BAR 20
  "~@8",

  // BAR 21
  // t=160 E4/G4/B4 for 2
  // t=162 D6 for 2
  // t=164 B5 for 2
  // t=166 A5 for 2
  "[e4,g4,b4]@2 d6@2 b5@2 a5@2",

  // BAR 22
  // t=174 D5 for 1
  // t=175 E5 for 1
  "~@6 d5 e5",

  // BAR 23
  // t=182 A5 for 1
  // t=183 F#5 for 1
  "~@6 a5 f#5"
)


// ============================================================
// PIANO
// ============================================================

stack(

  sweden
    .note()
    .s("piano")
    .attack(0.01)
    .decay(0.30)
    .sustain(0.42)
    .release(1.4)
    .room(0.82)
    .roomsize(8)
    .gain(0.65),

  ornaments
    .note()
    .s("piano")
    .attack(0.008)
    .decay(0.20)
    .sustain(0.35)
    .release(1.2)
    .room(0.86)
    .roomsize(8)
    .gain(0.60)

)
